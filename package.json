{
  "name": "xintel",
  "version": "0.2.0",
  "private": true,
  "description": "Local-only X.com intelligence collector with Notion ingestion (read-only).",
  "type": "module",
  "bin": {
    "xintel": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "marked": "^14.1.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright-core": "^1.49.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
